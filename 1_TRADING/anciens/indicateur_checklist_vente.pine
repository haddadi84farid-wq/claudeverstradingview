//@version=6
// Checklist visuelle du plan de vente XAUUSD : 3 conditions cochées en direct
// + mini-schéma des bougies attendues, dans le tableau.
// Fonctionne sur un graphique 1, 5 ou 15 min (calculs forcés en 15 min et 5 min). Ne passe aucun ordre.
indicator("Plan XAUUSD — checklist vente", overlay = true)

zLow       = input.float(4297.0,  "Zone de vente — bas")
zTop       = input.float(4303.0,  "Zone de vente — haut")
stopLvl    = input.float(4308.0,  "Stop")
invLvl     = input.float(4303.44, "Invalidation (clôture 15 min au-dessus)")
tp1        = input.float(4287.0,  "TP1")
tp2        = input.float(4257.0,  "TP2")
lots       = input.float(0.01,    "Taille (lots)")
endHourUtc = input.int(12,        "Fin de validité (heure UTC)", minval = 0, maxval = 23)
wickRatio  = input.float(0.5,     "Mèche haute minimale (part de la bougie)", minval = 0.1, maxval = 0.9)
tablePos   = input.string("En haut à droite", "Position du tableau", options = ["En haut à droite", "En haut à gauche", "En bas à droite", "En bas à gauche", "Au milieu à droite"])
textSize   = input.string("Petit", "Taille du texte", options = ["Très petit", "Petit", "Normal"])
showMini   = input.bool(true, "Mini-schéma sous le tableau")
cellW      = input.float(0.8, "Mini-schéma : largeur des cases (%)", minval = 0.2, maxval = 5.0, step = 0.1)
cellH      = input.float(1.0, "Mini-schéma : hauteur des cases (%)", minval = 0.2, maxval = 5.0, step = 0.1)

posMap = tablePos == "En haut à gauche" ? position.top_left : tablePos == "En bas à droite" ? position.bottom_right : tablePos == "En bas à gauche" ? position.bottom_left : tablePos == "Au milieu à droite" ? position.middle_right : position.top_right
txtSz  = textSize == "Très petit" ? size.tiny : textSize == "Normal" ? size.normal : size.small

// Les conditions 1, 2 et l'invalidation sont calculées sur des bougies 15 min,
// quelle que soit l'unité de temps affichée (1, 5 ou 15 min).
// 1. Le prix a atteint la zone (bougie 15 min en cours ou 3 précédentes)
touchedExpr() => ta.highest(high, 4) >= zLow

// 2. Rejet sur la dernière bougie 15 min CLÔTURÉE : elle a touché la zone,
//    longue mèche haute, clôture sous le milieu de la zone
//    La case reste cochée si ce rejet a eu lieu dans la dernière heure (4 bougies 15 min).
rejectionExpr() =>
    rng       = high - low
    upperWick = high - math.max(open, close)
    rej       = high >= zLow and rng > 0 and upperWick >= wickRatio * rng and close < zLow + (zTop - zLow) / 2
    since     = ta.barssince(rej[1])
    not na(since) and since <= 3

// Invalidation : une clôture 15 min au-dessus du niveau dans les 4 dernières heures
invalidExpr() => ta.highest(close[1], 16) > invLvl

[touched, rejection, invalidated] = request.security(syminfo.tickerid, "15", [touchedExpr(), rejectionExpr(), invalidExpr()])

// 3. Cassure de structure baissière en 5 min (approximation) : une clôture 5 min
//    sous le plus bas des 6 bougies 5 min précédentes, après un passage dans la zone
//    Compte dès la clôture de la bougie de cassure ; la case reste cochée 15 min (3 bougies 5 min).
choch5Expr() =>
    brk   = ta.highest(high, 12) >= zLow and close < ta.lowest(low, 6)[1]
    since = ta.barssince(brk[1])   // seulement des bougies 5 min clôturées
    not na(since) and since <= 2
choch5 = request.security(syminfo.tickerid, "5", choch5Expr())

expired     = hour(timenow, "UTC") >= endHourUtc
signal      = touched and rejection and choch5 and not invalidated and not expired

alertcondition(signal, "Signal vente XAU", "Les 3 conditions du plan de vente sont réunies")

// ---------- Tableau ----------
// 7 colonnes : col 0 = case à cocher, cols 1-6 = texte fusionné ; le mini-schéma utilise les 7 colonnes.
NCOL = 7
NROW = showMini ? 21 : 8
var table t = table.new(posMap, NCOL, NROW, bgcolor = color.white, border_color = color.white, border_width = 0, frame_color = color.gray, frame_width = 1)

mark(bool c) => c ? "✅" : "⬜"
px(float v) => str.tostring(v, "#.##")

// Fusion des cellules une seule fois (refusionner à chaque tick provoque une erreur)
if barstate.isfirst
    table.merge_cells(t, 0, 0, NCOL - 1, 0)
    for r = 1 to 3
        table.merge_cells(t, 1, r, NCOL - 1, r)
    for r = 4 to 7
        table.merge_cells(t, 0, r, NCOL - 1, r)
    if showMini
        table.merge_cells(t, 0, 8, NCOL - 1, 8)
        table.merge_cells(t, 0, 20, NCOL - 1, 20)

if barstate.islast
    statusTxt = invalidated ? "ANNULÉ : clôture au-dessus de " + px(invLvl) : expired ? "EXPIRÉ : après " + str.tostring(endHourUtc) + ":00 UTC" : signal ? "SIGNAL DE VENTE : à toi de décider" : "EN ATTENTE : ne rien faire"
    statusCol = invalidated or expired ? color.gray : signal ? color.red : color.orange
    table.cell(t, 0, 0, "PLAN VENTE XAUUSD", text_color = color.white, bgcolor = color.new(color.red, 15), text_halign = text.align_left, text_size = txtSz)
    table.cell(t, 0, 1, mark(touched), text_size = txtSz)
    table.cell(t, 1, 1, "1. Prix dans la zone " + px(zLow) + "–" + px(zTop), text_halign = text.align_left, text_size = txtSz)
    table.cell(t, 0, 2, mark(rejection), text_size = txtSz)
    table.cell(t, 1, 2, "2. Bougie 15 min rejetée (longue mèche haute)", text_halign = text.align_left, text_size = txtSz)
    table.cell(t, 0, 3, mark(choch5), text_size = txtSz)
    table.cell(t, 1, 3, "3. Cassure baissière en 5 min", text_halign = text.align_left, text_size = txtSz)
    table.cell(t, 0, 4, statusTxt, text_color = color.white, bgcolor = statusCol, text_halign = text.align_left, text_size = txtSz)
    table.cell(t, 0, 5, "Stop " + px(stopLvl) + "   TP1 " + px(tp1) + "   TP2 " + px(tp2), text_halign = text.align_left, text_size = txtSz)
    table.cell(t, 0, 6, "Taille : " + str.tostring(lots) + " lot — stop et TP activés", text_halign = text.align_left, text_size = txtSz)
    table.cell(t, 0, 7, "Valable jusqu'à " + str.tostring(endHourUtc) + ":00 UTC — invalidation > " + px(invLvl), text_halign = text.align_left, text_size = txtSz)

// ---------- Mini-schéma dans le tableau (lignes 8 à 20) ----------
// Grille de 11 lignes x 7 colonnes : bougie 1 en col 1, bougie 2 en col 3, bougie 3 en col 5.
// Seul trait horizontal : la limite d'entrée, rangée fine rouge (ligne 2 de la grille). Ligne 10 = numéros.
// La ligne 2 de la grille est le trait rouge : une rangée fine entièrement rouge.
miniCell(int col, int gRow, string txt, color bg, color tc) =>
    table.cell(t, col, 9 + gRow, gRow == 2 ? "" : txt, width = cellW, height = gRow == 2 ? cellH * 0.3 : cellH, bgcolor = gRow == 2 ? color.red : bg, text_color = tc, text_size = size.tiny, text_halign = text.align_center, text_valign = text.align_center)

if barstate.islast and showMini
    table.cell(t, 0, 8, "Schéma attendu", text_color = color.white, bgcolor = color.new(color.gray, 20), text_halign = text.align_left, text_size = txtSz)
    for gRow = 0 to 10
        for col = 0 to NCOL - 1
            miniCell(col, gRow, "", color.white, color.red)
    // bougie 1 (montée, verte) : mèche lignes 3 et 7, corps lignes 4-6
    miniCell(1, 3, "│", color.white, color.teal)
    for gRow = 4 to 6
        miniCell(1, gRow, "", color.teal, color.teal)
    miniCell(1, 7, "│", color.white, color.teal)
    // bougie 2 (rejet, rouge) : longue mèche au-dessus de la limite d'entrée, lignes 0-2, corps lignes 3-4, mèche basse ligne 5
    for gRow = 0 to 2
        miniCell(3, gRow, "│", color.white, color.red)
    for gRow = 3 to 4
        miniCell(3, gRow, "", color.red, color.red)
    miniCell(3, 5, "│", color.white, color.red)
    // bougie 3 (cassure, rouge) : mèche ligne 4, corps lignes 5-8 (sous le creux), mèche ligne 9
    miniCell(5, 4, "│", color.white, color.red)
    for gRow = 5 to 8
        miniCell(5, gRow, "", color.red, color.red)
    miniCell(5, 9, "│", color.white, color.red)
    // numéros
    miniCell(1, 10, "1", color.white, color.black)
    miniCell(3, 10, "2", color.white, color.black)
    miniCell(5, 10, "3", color.white, color.black)
    table.cell(t, 0, 20, "1 monte → 2 mèche au-dessus du trait rouge (entrée) → 3 cassure : vente", text_halign = text.align_left, text_size = size.tiny)
