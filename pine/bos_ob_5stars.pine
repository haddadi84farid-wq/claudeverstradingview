//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// BOS + Order Block 5★ — Multi-TF
// Modèle (baissier ; haussier = miroir) :
//   OB → la MÈCHE de la bougie suivante balaie le haut de l'OB → impulsion avec FVG → BOS
//   Zone = OB + bougie de sweep (du haut de la mèche au plus bas des deux bougies).
// Étoiles :
//   ★ OB à l'origine de l'impulsion
//   ★ FVG (displacement)
//   ★ BOS confirmé à la clôture (avant ou après l'OB, dans la fenêtre)
//   ★ Sweep interne : la mèche de la bougie suivante dépasse l'OB, SANS casser un sommet externe
//   ★ Aligné : l'OB va dans le sens de la tendance HTF (BOS du TF d'alignement)
//   ⚠ Liquidité externe (la mèche casse aussi un vrai sommet) = malus : souvent une continuation
//   + OTE (confirmation) : l'OB est dans le retracement 61,8–79 % de la jambe précédente
// Multi-TF : même moteur sur M5 / M15 / H1 / H4 (non-repaint, [1] + lookahead_on).
// ─────────────────────────────────────────────────────────────────────────────
indicator("BOS + Order Block 5★ — Multi-TF", "BOS OB 5★", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================ INPUTS ================================
g1 = "1) Détection"
lenSw   = input.int(2, "Pivot de structure (bougies de chaque côté)", minval=1, group=g1)
fAfter  = input.int(3, "FVG : peut démarrer jusqu'à N bougies après le sommet", minval=0, maxval=10, group=g1)
bosWin  = input.int(12, "BOS : doit arriver dans les N bougies après l'OB", minval=1, maxval=50, group=g1)
extLook = input.int(10, "Liquidité externe : sommets des N bougies avant l'OB", minval=2, maxval=50, group=g1)
incWick = input.bool(false, "Zone : inclure la mèche du sweep (sinon bougie OB seule)", group=g1)
minGap  = input.float(0.0, "FVG minimum (x ATR)", minval=0.0, step=0.05, group=g1)
extMode = input.string("Malus (pas d'étoile sweep)", "Liquidité externe", options=["Malus (pas d'étoile sweep)", "Exclure l'OB", "Ignorer"], group=g1)
tfAlign = input.timeframe("60", "TF d'alignement (tendance HTF)", group=g1)

gO = "1b) OTE (confirmation)"
oteLen = input.int(5, "Swings majeurs : pivot (bougies de chaque côté)", minval=2, group=gO)
oteLo  = input.float(0.618, "OTE : début (ratio)", minval=0.3, maxval=0.9, step=0.001, group=gO)
oteHi  = input.float(0.79, "OTE : fin (ratio)", minval=0.4, maxval=0.95, step=0.001, group=gO)
reqOte = input.bool(false, "Afficher seulement les OB en OTE", group=gO)

g2 = "2) Affichage"
tfShow    = input.timeframe("", "TF des OB affichés (vide = TF du graphique)", group=g2)
maxPerDir = input.int(3, "OB affichés par sens (les plus PROCHES du prix, anciens inclus)", minval=1, maxval=20, group=g2)
maxSize   = input.float(3.0, "Ignorer les OB plus hauts que N x ATR (0 = off)", minval=0.0, step=0.5, group=g2)
minStars  = input.int(3, "Étoiles minimum affichées", minval=3, maxval=5, group=g2)
maxObs    = input.int(60, "OB frais gardés en mémoire", minval=5, maxval=150, group=g2)
extR      = input.int(15, "Extension à droite (bougies)", minval=0, group=g2)
showBos   = input.bool(true, "Afficher les BOS", group=g2)
hideTouch = input.bool(true, "Masquer un OB dès qu'il est touché (seulement les OB frais)", group=g2)
showInval = input.bool(false, "Garder les OB invalidés (gris)", group=g2)

g3 = "3) Multi-TF"
useMtf   = input.bool(true, "Analyser les TF supérieurs", group=g3)
tfA      = input.timeframe("5", "TF 1", group=g3)
tfB      = input.timeframe("15", "TF 2", group=g3)
tfC      = input.timeframe("60", "TF 3", group=g3)
tfD      = input.timeframe("240", "TF 4", group=g3)
showHtf  = input.bool(false, "Dessiner aussi les OB des TF du tableau", group=g3)
htfStars = input.int(4, "Étoiles minimum (TF supérieurs)", minval=3, maxval=5, group=g3)
showTbl  = input.bool(true, "Tableau multi-TF", group=g3)

g5 = "5) Mesure de performance (backtest des OB)"
btOn   = input.bool(true, "Mesurer chaque OB : ordre limite dans l'OB", group=g5)
entPct = input.float(0.5, "Entrée : profondeur dans l'OB (0,5 = 50 %)", minval=0.0, maxval=1.0, step=0.05, group=g5)
btBuf  = input.float(0.1, "SL : marge au-delà de l'OB (x ATR)", minval=0.0, step=0.05, group=g5)
btExp  = input.int(50, "Ordre annulé après N bougies sans entrée", minval=5, group=g5)
btHold = input.int(100, "Durée max d'un trade (bougies)", minval=5, group=g5)
btCost = input.float(0.35, "Coût spread + frais (en prix)", minval=0.0, step=0.05, group=g5)
showBt = input.bool(true, "Tableau de performance", group=g5)
sessA  = input.session("0800-1100", "Session London", group=g5)
sessB  = input.session("1430-1700", "Session New York", group=g5)
sessTz = input.string("Europe/Paris", "Fuseau horaire", group=g5)

g4 = "4) Couleurs"
cBear = input.color(#EF5350, "OB vente", group=g4)
cBull = input.color(#26A69A, "OB achat", group=g4)
c5    = input.color(#FFD600, "Bordure 5★", group=g4)
cBos  = input.color(#E91E63, "BOS", group=g4)

// ============================ OUTILS ================================
f_stars(int n) =>
    int m = n % 10
    str.repeat("★", m) + str.repeat("☆", 5 - m) + (n >= 10 ? " +OTE" : "")

f_tfName(string tf) =>
    int s = timeframe.in_seconds(tf)
    s < 3600 ? "M" + str.tostring(s / 60) : s < 86400 ? "H" + str.tostring(s / 3600) : s < 604800 ? "D" : "W"

f_state(int st) =>
    st == 0 ? "frais" : st == 1 ? "touché" : "invalidé"

// Candidat OB quand un FVG se forme (bougies [2],[1],[0]).
// s = bougie au sommet (creux) du mouvement juste avant le FVG.
// Si sa mèche dépasse la bougie d'avant → OB = bougie d'avant, sweep = vrai.
f_cand(int dir, int fa, float gapAtr, float a, int xl, bool incW) =>
    bool fvg = dir == -1 ? (high < low[2] and low[2] - high >= gapAtr * a) : (low > high[2] and low - high[2] >= gapAtr * a)
    int kOb = -1
    float top = na
    float bot = na
    bool sw = false
    bool ext = false
    if fvg
        int s = 2
        for k = 2 to 3 + fa
            if dir == -1 ? high[k] > high[s] : low[k] < low[s]
                s := k
        // OB = dernière bougie OPPOSÉE (haussière pour une vente) au sommet ou juste avant
        kOb := s
        for k = s to s + 3
            if dir == -1 ? close[k] >= open[k] : close[k] <= open[k]
                kOb := k
                break
        // sweep = une bougie plus récente (le sommet) dépasse l'OB par la mèche
        sw := kOb > s and (dir == -1 ? high[s] > high[kOb] : low[s] < low[kOb])
        top := dir == -1 and incW and sw ? high[s] : high[kOb]
        bot := dir == 1 and incW and sw ? low[s] : low[kOb]
        float ref = dir == -1 ? high[kOb + 1] : low[kOb + 1]
        for j = kOb + 1 to kOb + xl
            ref := dir == -1 ? math.max(ref, high[j]) : math.min(ref, low[j])
        ext := sw and (dir == -1 ? high[s] > ref : low[s] < ref)
    [kOb, top, bot, sw, ext]

// OTE : l'OB doit se trouver dans le retracement 61,8–79 % de la jambe PRÉCÉDENTE.
// Vente : sommet majeur H → creux majeur L (avant l'OB), le rebond vers l'OB remonte en 61,8–79 % de H-L.
f_ote(int dir, float top, float bot, int obBar, array<float> hp, array<int> hi, array<float> lp, array<int> li) =>
    bool res = false
    if hp.size() > 0 and lp.size() > 0
        if dir == -1
            float L = na
            int Li = na
            for k = lp.size() - 1 to 0
                if li.get(k) < obBar
                    L := lp.get(k)
                    Li := li.get(k)
                    break
            if not na(L)
                float H = na
                for k = hp.size() - 1 to 0
                    if hi.get(k) < Li
                        H := hp.get(k)
                        break
                if not na(H) and H > L
                    float zB = L + oteLo * (H - L)
                    float zT = L + oteHi * (H - L)
                    res := math.min(top, zT) > math.max(bot, zB)
        else
            float H = na
            int Hi = na
            for k = hp.size() - 1 to 0
                if hi.get(k) < obBar
                    H := hp.get(k)
                    Hi := hi.get(k)
                    break
            if not na(H)
                float L = na
                for k = lp.size() - 1 to 0
                    if li.get(k) < Hi
                        L := lp.get(k)
                        break
                if not na(L) and H > L
                    float zT = H - oteLo * (H - L)
                    float zB = H - oteHi * (H - L)
                    res := math.min(top, zT) > math.max(bot, zB)
    res

// Tendance de structure (dernier BOS) d'un TF, valeur de la bougie clôturée
f_trend(int len) =>
    float h = ta.pivothigh(high, len, len)
    float l = ta.pivotlow(low, len, len)
    var float sh = na
    var float sl = na
    var int tr = 0
    if not na(h)
        sh := h
    if not na(l)
        sl := l
    if not na(sh) and close > sh
        tr := 1
        sh := na
    else if not na(sl) and close < sl
        tr := -1
        sl := na
    tr[1]

// sweep utile = sweep interne ; la liquidité externe est un malus (ou une exclusion)
f_swStar(bool sw, bool ext) =>
    sw and (not ext or extMode == "Ignorer")

// Le prix est-il déjà revenu dans l'OB entre sa formation et la confirmation par le BOS ?
// (on saute l'OB, la bougie de sweep et la 1re bougie d'impulsion)
f_mitig(int dir, float top, float bot, int obBar) =>
    bool r = false
    int n = bar_index - obBar - 3
    if n >= 0
        for k = 0 to n
            if dir == -1 ? high[k] >= bot : low[k] <= top
                r := true
                break
    r

// ============ MOTEUR (utilisé pour chaque TF supérieur) ============
// Renvoie le dernier BOS + le dernier OB vente / achat confirmé (valeurs de la bougie CLÔTURÉE).
f_engine(int len, int fa, int bw, int xl, float gapAtr, bool incW) =>
    float a  = ta.atr(14)
    int swingTr = f_trend(len * 5)
    float ePh = ta.pivothigh(high, len, len)
    float ePl = ta.pivotlow(low, len, len)
    var float eSH = na
    var float eSL = na
    var int   eBos = 0
    var int   lastBearBos = na
    var int   lastBullBos = na
    // candidats en attente de BOS
    var float pdTop = na
    var float pdBot = na
    var int   pdTm = na
    var int   pdBar = na
    var int   pdObBar = na
    var int   pdSt = 0
    var float puTop = na
    var float puBot = na
    var int   puTm = na
    var int   puBar = na
    var int   puObBar = na
    var int   puSt = 0
    // OB confirmés
    var float dTop = na
    var float dBot = na
    var int   dTm = na
    var int   dSt = 0
    var int   dState = 2
    var int   dDet = na
    var float uTop = na
    var float uBot = na
    var int   uTm = na
    var int   uSt = 0
    var int   uState = 2
    var int   uDet = na
    float mPh = ta.pivothigh(high, oteLen, oteLen)
    float mPl = ta.pivotlow(low, oteLen, oteLen)
    var array<float> mhp = array.new_float()
    var array<int>   mhi = array.new_int()
    var array<float> mlp = array.new_float()
    var array<int>   mli = array.new_int()
    if not na(mPh)
        mhp.push(mPh)
        mhi.push(bar_index - oteLen)
        if mhp.size() > 10
            mhp.shift()
            mhi.shift()
    if not na(mPl)
        mlp.push(mPl)
        mli.push(bar_index - oteLen)
        if mlp.size() > 10
            mlp.shift()
            mli.shift()
    if not na(ePh)
        eSH := ePh
    if not na(ePl)
        eSL := ePl
    // états
    if dState < 2 and not na(dTop)
        if close > dTop
            dState := 2
        else if bar_index > dDet and high >= dBot
            dState := 1
    if uState < 2 and not na(uTop)
        if close < uBot
            uState := 2
        else if bar_index > uDet and low <= uTop
            uState := 1
    if not na(pdTop) and close > pdTop
        pdTop := na
    if not na(puBot) and close < puBot
        puBot := na
        puTop := na
    // candidats
    [kD, tD, bD, swD, exD] = f_cand(-1, fa, gapAtr, a, xl, incW)
    if kD > 0
        pdTop := tD
        pdBot := bD
        pdTm := time[kD]
        pdBar := bar_index
        pdObBar := bar_index - kD
        pdSt := extMode == "Exclure l'OB" and exD ? -99 : 2 + (f_swStar(swD, exD) ? 1 : 0)
    [kU, tU, bU, swU, exU] = f_cand(1, fa, gapAtr, a, xl, incW)
    if kU > 0
        puTop := tU
        puBot := bU
        puTm := time[kU]
        puBar := bar_index
        puObBar := bar_index - kU
        puSt := extMode == "Exclure l'OB" and exU ? -99 : 2 + (f_swStar(swU, exU) ? 1 : 0)
    // BOS à la clôture
    if not na(eSL) and close < eSL
        eBos := -1
        lastBearBos := bar_index
        eSL := na
    else if not na(eSH) and close > eSH
        eBos := 1
        lastBullBos := bar_index
        eSH := na
    // confirmation : BOS entre l'OB et OB + bw bougies
    if not na(pdTop) and pdSt >= 0 and not na(lastBearBos) and lastBearBos >= pdObBar and lastBearBos - pdObBar <= bw
        dTop := pdTop
        dBot := pdBot
        dTm := pdTm
        dSt := pdSt + 1 + (swingTr == -1 ? 1 : 0) + (f_ote(-1, pdTop, pdBot, pdObBar, mhp, mhi, mlp, mli) ? 10 : 0)
        dState := f_mitig(-1, pdTop, pdBot, pdObBar) ? 1 : 0
        dDet := bar_index
        pdTop := na
    else if not na(pdTop) and bar_index - pdObBar > bw
        pdTop := na
    if not na(puTop) and puSt >= 0 and not na(lastBullBos) and lastBullBos >= puObBar and lastBullBos - puObBar <= bw
        uTop := puTop
        uBot := puBot
        uTm := puTm
        uSt := puSt + 1 + (swingTr == 1 ? 1 : 0) + (f_ote(1, puTop, puBot, puObBar, mhp, mhi, mlp, mli) ? 10 : 0)
        uState := f_mitig(1, puTop, puBot, puObBar) ? 1 : 0
        uDet := bar_index
        puTop := na
    else if not na(puTop) and bar_index - puObBar > bw
        puTop := na
    [eBos[1], dTop[1], dBot[1], dTm[1], dSt[1], dState[1], uTop[1], uBot[1], uTm[1], uSt[1], uState[1]]

// ================== TF DU GRAPHIQUE : détection + dessin ==================
type OB
    float top
    float bot
    int   dir
    int   x
    int   det
    int   stars
    bool  sw
    bool  ext
    int   state
    box   bx
    label lb
    bool  ote
    bool  al

type Cand
    float top
    float bot
    int   obBar
    bool  sw
    bool  ext

var array<OB> obs = array.new<OB>()
var array<float> gHp = array.new_float()
var array<int>   gHi = array.new_int()
var array<float> gLp = array.new_float()
var array<int>   gLi = array.new_int()
float gMh = ta.pivothigh(high, oteLen, oteLen)
float gMl = ta.pivotlow(low, oteLen, oteLen)
if barstate.isconfirmed
    if not na(gMh)
        gHp.push(gMh)
        gHi.push(bar_index - oteLen)
        if gHp.size() > 10
            gHp.shift()
            gHi.shift()
    if not na(gMl)
        gLp.push(gMl)
        gLi.push(bar_index - oteLen)
        if gLp.size() > 10
            gLp.shift()
            gLi.shift()
bool useChart = tfShow == "" or tfShow == timeframe.period
// tendance du TF d'alignement (non-repaint)
string tAl  = timeframe.in_seconds(tfAlign) > timeframe.in_seconds() ? tfAlign : timeframe.period
int htfDir  = request.security(syminfo.tickerid, tAl, f_trend(lenSw), lookahead=barmerge.lookahead_on)
bool inSessNow = not na(time(timeframe.period, sessA, sessTz)) or not na(time(timeframe.period, sessB, sessTz))

var Cand candD = na
var Cand candU = na
float atr = ta.atr(14)
float ph  = ta.pivothigh(high, lenSw, lenSw)
float pl  = ta.pivotlow(low, lenSw, lenSw)
var float sH = na
var float sL = na
var int   sHi = na
var int   sLi = na
var int   bosDir = 0
var int   lastBearBos = na
var int   lastBullBos = na

bool evBos  = false
bool evNew5 = false
bool evNew5Ote = false
bool evNewBear = false
bool evNewBull = false

// ===================== MESURE DE PERFORMANCE =====================
// Chaque OB confirmé = un ordre limite à 50 % de l'OB, SL au-delà de l'OB.
// On mesure si 1R / 2R / 3R sont atteints AVANT le SL (SL prioritaire dans une même bougie).
type Trade
    int   dir
    float en
    float sl
    float risk
    int   g
    bool  ote
    bool  al
    bool  sess
    int   created
    int   fillBar
    int   state
    float mfe

var array<Trade> trades = array.new<Trade>()
// index : 0 = 3★, 1 = 4★, 2 = 5★, 3 = OTE ✓, 4 = aligné HTF, 5 = contre HTF, 6 = en session, 7 = hors session, 8 = total
var array<int>   bN  = array.new_int(9, 0)
var array<int>   b1  = array.new_int(9, 0)
var array<int>   b2  = array.new_int(9, 0)
var array<int>   b3  = array.new_int(9, 0)
var array<float> bR1 = array.new_float(9, 0.0)
var array<float> bR2 = array.new_float(9, 0.0)
var array<float> bR3 = array.new_float(9, 0.0)
var int bExp = 0

f_addTrade(Cand c, int d, int st) =>
    if btOn and (maxSize <= 0 or c.top - c.bot <= maxSize * atr)
        float en = d == -1 ? c.bot + (c.top - c.bot) * entPct : c.top - (c.top - c.bot) * entPct
        float sl = d == -1 ? c.top + btBuf * atr : c.bot - btBuf * atr
        float rk = math.max(math.abs(en - sl), syminfo.mintick)
        trades.push(Trade.new(d, en, sl, rk, st % 10, st % 100 >= 10, st >= 100, false, bar_index, na, 0, 0.0))
    0

// exitR = résultat en R si l'objectif n'est pas atteint (SL = -1, sortie au temps = R à la clôture)
f_rec(Trade t, float exitR) =>
    array<int> ks = array.from(t.g - 3, 8, t.al ? 4 : 5, t.sess ? 6 : 7)
    if t.ote
        ks.push(3)
    float c = btCost / t.risk
    float r1 = (t.mfe >= 1.0 ? 1.0 : exitR) - c
    float r2 = (t.mfe >= 2.0 ? 2.0 : exitR) - c
    float r3 = (t.mfe >= 3.0 ? 3.0 : exitR) - c
    for k in ks
        bN.set(k, bN.get(k) + 1)
        b1.set(k, b1.get(k) + (t.mfe >= 1.0 ? 1 : 0))
        b2.set(k, b2.get(k) + (t.mfe >= 2.0 ? 1 : 0))
        b3.set(k, b3.get(k) + (t.mfe >= 3.0 ? 1 : 0))
        bR1.set(k, bR1.get(k) + r1)
        bR2.set(k, bR2.get(k) + r2)
        bR3.set(k, bR3.get(k) + r3)
    0

f_label(OB o) =>
    (o.dir == -1 ? "OB VENTE " : "OB ACHAT ") + f_stars(o.stars) + "\nsweep " + (o.sw ? "✓" : "✗") + (o.ext ? " · liq. ext ⚠" : "") + " · HTF " + (o.al ? "✓" : "✗") + " · OTE " + (o.ote ? "✓" : "✗") + " · " + f_state(o.state)

f_confirm(Cand c, int d) =>
    bool al = htfDir == d
    int st = 3 + (f_swStar(c.sw, c.ext) ? 1 : 0) + (al ? 1 : 0)
    bool ote = f_ote(d, c.top, c.bot, c.obBar, gHp, gHi, gLp, gLi)
    bool excl = extMode == "Exclure l'OB" and c.ext
    bool sizeOk = maxSize <= 0 or c.top - c.bot <= maxSize * atr
    // déjà consommé avant la confirmation → pas un OB frais (ni dessiné si masquage, ni tradé)
    bool mitig = f_mitig(d, c.top, c.bot, c.obBar)
    bool drawIt = not (mitig and hideTouch)
    // pas de doublon : si un OB frais du même sens chevauche, on garde le plus étoilé (à égalité, le plus récent)
    bool better = true
    if useChart and sizeOk and st >= minStars and obs.size() > 0
        for i = obs.size() - 1 to 0
            OB q = obs.get(i)
            if drawIt and q.dir == d and q.state < 2 and math.min(q.top, c.top) > math.max(q.bot, c.bot)
                if q.state == 0 and q.stars > st and not mitig
                    better := false
                else
                    box.delete(q.bx)
                    label.delete(q.lb)
                    obs.remove(i)
    if useChart and drawIt and sizeOk and st >= minStars and better and (not reqOte or ote) and not excl
        color col = d == -1 ? cBear : cBull
        bool five = st == 5
        box b = box.new(c.obBar, c.top, bar_index + extR, c.bot, bgcolor=color.new(col, five ? 70 : st == 4 ? 80 : 88), border_color=five ? c5 : color.new(col, 50), border_width=five ? 2 : 1)
        OB o = OB.new(c.top, c.bot, d, c.obBar, bar_index, st, c.sw, c.ext, mitig ? 1 : 0, b, na, ote, al)
        o.lb := label.new(bar_index + extR, (c.top + c.bot) / 2, f_label(o), style=label.style_label_left, color=color.new(col, 100), textcolor=five ? c5 : col, size=size.small)
        obs.push(o)
        while obs.size() > maxObs
            OB old = obs.shift()
            box.delete(old.bx)
            label.delete(old.lb)
    excl or mitig ? -1 : st + (ote ? 10 : 0) + (al ? 100 : 0)

if barstate.isconfirmed
    if not na(ph)
        sH := ph
        sHi := bar_index - lenSw
    if not na(pl)
        sL := pl
        sLi := bar_index - lenSw

    // ---- états des OB : touché / invalidé, extension
    if obs.size() > 0
        for i = obs.size() - 1 to 0
            OB o = obs.get(i)
            if o.state < 2
                bool inval = o.dir == -1 ? close > o.top : close < o.bot
                if inval
                    o.state := 2
                    if showInval
                        box.set_right(o.bx, bar_index)
                        box.set_bgcolor(o.bx, color.new(color.gray, 85))
                        box.set_border_color(o.bx, color.new(color.gray, 60))
                        label.set_text(o.lb, f_label(o))
                        label.set_textcolor(o.lb, color.gray)
                    else
                        box.delete(o.bx)
                        label.delete(o.lb)
                        obs.remove(i)
                        continue
                else
                    if o.state == 0 and bar_index > o.det and (o.dir == -1 ? high >= o.bot : low <= o.top)
                        o.state := 1
                        if hideTouch
                            box.delete(o.bx)
                            label.delete(o.lb)
                            obs.remove(i)
                            continue
                    box.set_right(o.bx, bar_index + extR)
                    label.set_x(o.lb, bar_index + extR)
                    label.set_text(o.lb, f_label(o))

    // ---- candidats invalidés avant le BOS
    if not na(candD)
        if close > candD.top or bar_index - candD.obBar > bosWin
            candD := na
    if not na(candU)
        if close < candU.bot or bar_index - candU.obBar > bosWin
            candU := na

    // ---- nouveaux candidats (au moment où le FVG se forme)
    [cKD, cTD, cBD, cSwD, cExD] = f_cand(-1, fAfter, minGap, atr, extLook, incWick)
    if cKD > 0
        candD := Cand.new(cTD, cBD, bar_index - cKD, cSwD, cExD)
    [cKU, cTU, cBU, cSwU, cExU] = f_cand(1, fAfter, minGap, atr, extLook, incWick)
    if cKU > 0
        candU := Cand.new(cTU, cBU, bar_index - cKU, cSwU, cExU)

    // ---- BOS à la clôture
    if not na(sL) and close < sL
        if showBos and useChart
            line.new(sLi, sL, bar_index, sL, color=cBos, width=1)
            label.new(int(math.round((sLi + bar_index) / 2)), sL, "BOS", style=label.style_label_up, color=color.new(cBos, 100), textcolor=cBos, size=size.tiny)
        bosDir := -1
        lastBearBos := bar_index
        sL := na
        evBos := true
    else if not na(sH) and close > sH
        if showBos and useChart
            line.new(sHi, sH, bar_index, sH, color=cBos, width=1)
            label.new(int(math.round((sHi + bar_index) / 2)), sH, "BOS", style=label.style_label_down, color=color.new(cBos, 100), textcolor=cBos, size=size.tiny)
        bosDir := 1
        lastBullBos := bar_index
        sH := na
        evBos := true

    // ---- confirmation : BOS entre l'OB et OB + bosWin bougies (avant ou après le FVG)
    if not na(candD) and not na(lastBearBos)
        if lastBearBos >= candD.obBar and lastBearBos - candD.obBar <= bosWin
            int st0 = f_confirm(candD, -1)
            int st = st0 % 100
            if st0 >= 0
                f_addTrade(candD, -1, st0)
            evNewBear := st0 >= 0
            evNew5 := evNew5 or (st0 >= 0 and st % 10 == 5)
            evNew5Ote := evNew5Ote or (st0 >= 0 and st == 15)
            candD := na
    if not na(candU) and not na(lastBullBos)
        if lastBullBos >= candU.obBar and lastBullBos - candU.obBar <= bosWin
            int st0 = f_confirm(candU, 1)
            int st = st0 % 100
            if st0 >= 0
                f_addTrade(candU, 1, st0)
            evNewBull := st0 >= 0
            evNew5 := evNew5 or (st0 >= 0 and st % 10 == 5)
            evNew5Ote := evNew5Ote or (st0 >= 0 and st == 15)
            candU := na

// ======================= MULTI-TF (non-repaint) =======================
int chartSec = timeframe.in_seconds()
bool okA = useMtf and timeframe.in_seconds(tfA) > chartSec
bool okB = useMtf and timeframe.in_seconds(tfB) > chartSec
bool okC = useMtf and timeframe.in_seconds(tfC) > chartSec
bool okD = useMtf and timeframe.in_seconds(tfD) > chartSec
string tA = okA ? tfA : timeframe.period
string tB = okB ? tfB : timeframe.period
string tC = okC ? tfC : timeframe.period
string tD = okD ? tfD : timeframe.period
[aBos, aDT, aDB, aDTm, aDS, aDSt, aUT, aUB, aUTm, aUS, aUSt] = request.security(syminfo.tickerid, tA, f_engine(lenSw, fAfter, bosWin, extLook, minGap, incWick), lookahead=barmerge.lookahead_on)
[bBos, bDT, bDB, bDTm, bDS, bDSt, bUT, bUB, bUTm, bUS, bUSt] = request.security(syminfo.tickerid, tB, f_engine(lenSw, fAfter, bosWin, extLook, minGap, incWick), lookahead=barmerge.lookahead_on)
[cBosD, cDT, cDB, cDTm, cDS, cDSt, cUT, cUB, cUTm, cUS, cUSt] = request.security(syminfo.tickerid, tC, f_engine(lenSw, fAfter, bosWin, extLook, minGap, incWick), lookahead=barmerge.lookahead_on)
[dBos, dDT, dDB, dDTm, dDS, dDSt, dUT, dUB, dUTm, dUS, dUSt] = request.security(syminfo.tickerid, tD, f_engine(lenSw, fAfter, bosWin, extLook, minGap, incWick), lookahead=barmerge.lookahead_on)
string tS = useChart ? timeframe.period : tfShow
[sBos, sDT, sDB, sDTm, sDS, sDSt, sUT, sUB, sUTm, sUS, sUSt] = request.security(syminfo.tickerid, tS, f_engine(lenSw, fAfter, bosWin, extLook, minGap, incWick), lookahead=barmerge.lookahead_on)

bool htfNew5 = (okA and ((aDS % 10 == 5 and aDTm != aDTm[1]) or (aUS % 10 == 5 and aUTm != aUTm[1]))) or (okB and ((bDS % 10 == 5 and bDTm != bDTm[1]) or (bUS % 10 == 5 and bUTm != bUTm[1]))) or (okC and ((cDS % 10 == 5 and cDTm != cDTm[1]) or (cUS % 10 == 5 and cUTm != cUTm[1]))) or (okD and ((dDS % 10 == 5 and dDTm != dDTm[1]) or (dUS % 10 == 5 and dUTm != dUTm[1])))

var array<box>   hBx = array.new<box>()
var array<label> hLb = array.new<label>()
var table tb = table.new(position.top_right, 4, 6, bgcolor=color.new(#0B1F3A, 8), border_width=1, border_color=color.new(color.gray, 60))

f_htfZone(bool ok, string tf, float top, float bot, int tm, int st, int state, int d, bool force) =>
    if ok and (showHtf or force) and not na(top) and (hideTouch ? state == 0 : state < 2) and st % 10 >= (force ? minStars : htfStars) and (not reqOte or st >= 10)
        color c = d == -1 ? cBear : cBull
        int xr = time + extR * chartSec * 1000
        hBx.push(box.new(tm, top, xr, bot, xloc=xloc.bar_time, bgcolor=color.new(c, 92), border_color=st % 10 == 5 ? c5 : color.new(c, 40), border_style=line.style_dashed, border_width=st % 10 == 5 ? 2 : 1))
        hLb.push(label.new(xr, top, "OB " + f_tfName(tf) + " " + (d == -1 ? "VENTE " : "ACHAT ") + f_stars(st) + " · " + f_state(state), xloc=xloc.bar_time, style=label.style_label_left, color=color.new(c, 100), textcolor=st % 10 == 5 ? c5 : c, size=size.small))
    0

f_cell(float top, float bot, int st, int state) =>
    na(top) or (hideTouch and state != 0) ? "—" : str.tostring(bot, format.mintick) + " – " + str.tostring(top, format.mintick) + "  " + f_stars(st) + " · " + f_state(state)

f_row(int r, bool ok, string tf, int bos, float dT, float dB, int dS, int dSt, float uT, float uB, int uS, int uSt) =>
    color w = color.white
    table.cell(tb, 0, r, f_tfName(tf), text_color=w, text_size=size.small)
    if not ok
        table.cell(tb, 1, r, "TF ≤ graphique", text_color=color.gray, text_size=size.small)
        table.cell(tb, 2, r, "", text_size=size.small)
        table.cell(tb, 3, r, "", text_size=size.small)
    else
        table.cell(tb, 1, r, bos == 1 ? "haussier ▲" : bos == -1 ? "baissier ▼" : "—", text_color=bos == 1 ? cBull : bos == -1 ? cBear : color.gray, text_size=size.small)
        table.cell(tb, 2, r, f_cell(dT, dB, dS, dSt), text_color=dS % 10 == 5 and dSt < 2 ? c5 : dSt == 2 ? color.gray : cBear, text_size=size.small, text_halign=text.align_left)
        table.cell(tb, 3, r, f_cell(uT, uB, uS, uSt), text_color=uS % 10 == 5 and uSt < 2 ? c5 : uSt == 2 ? color.gray : cBull, text_size=size.small, text_halign=text.align_left)
    0

// Affichage : seulement les maxPerDir OB frais les plus PROCHES du prix, par sens (les autres restent en mémoire, masqués)
f_style(OB o, bool vis, float distAtr) =>
    color col = o.dir == -1 ? cBear : cBull
    bool five = o.stars == 5
    box.set_bgcolor(o.bx, vis ? color.new(col, five ? 70 : o.stars == 4 ? 80 : 88) : color.new(col, 100))
    box.set_border_color(o.bx, vis ? (five ? c5 : color.new(col, 50)) : color.new(col, 100))
    label.set_textcolor(o.lb, vis ? (five ? c5 : col) : color.new(col, 100))
    if vis
        label.set_text(o.lb, f_label(o) + " · " + (distAtr <= 0 ? "prix dans la zone" : str.tostring(distAtr, "0.0") + " ATR"))
    0

if barstate.islast and obs.size() > 0
    array<float> dS = array.new_float()
    array<int>   iS = array.new_int()
    array<float> dB = array.new_float()
    array<int>   iB = array.new_int()
    for [i, o] in obs
        if o.state < 2
            float dist = o.dir == -1 ? math.max(0.0, o.bot - close) : math.max(0.0, close - o.top)
            if o.dir == -1
                dS.push(dist)
                iS.push(i)
            else
                dB.push(dist)
                iB.push(i)
    if dS.size() > 0
        array<int> ord = dS.sort_indices(order.ascending)
        for k = 0 to ord.size() - 1
            f_style(obs.get(iS.get(ord.get(k))), k < maxPerDir, atr > 0 ? dS.get(ord.get(k)) / atr : 0.0)
    if dB.size() > 0
        array<int> ordB = dB.sort_indices(order.ascending)
        for k = 0 to ordB.size() - 1
            f_style(obs.get(iB.get(ordB.get(k))), k < maxPerDir, atr > 0 ? dB.get(ordB.get(k)) / atr : 0.0)

if barstate.islast
    for b in hBx
        box.delete(b)
    for l in hLb
        label.delete(l)
    hBx.clear()
    hLb.clear()
    f_htfZone(okA, tfA, aDT, aDB, aDTm, aDS, aDSt, -1, false)
    f_htfZone(okA, tfA, aUT, aUB, aUTm, aUS, aUSt, 1, false)
    f_htfZone(okB, tfB, bDT, bDB, bDTm, bDS, bDSt, -1, false)
    f_htfZone(okB, tfB, bUT, bUB, bUTm, bUS, bUSt, 1, false)
    f_htfZone(okC, tfC, cDT, cDB, cDTm, cDS, cDSt, -1, false)
    f_htfZone(okC, tfC, cUT, cUB, cUTm, cUS, cUSt, 1, false)
    f_htfZone(okD, tfD, dDT, dDB, dDTm, dDS, dDSt, -1, false)
    f_htfZone(okD, tfD, dUT, dUB, dUTm, dUS, dUSt, 1, false)
    // TF choisi (différent du graphique) : ses derniers OB frais uniquement
    if not useChart
        f_htfZone(true, tfShow, sDT, sDB, sDTm, sDS, sDSt, -1, true)
        f_htfZone(true, tfShow, sUT, sUB, sUTm, sUS, sUSt, 1, true)

    if showTbl
        table.cell(tb, 0, 0, "TF", text_color=color.white, text_size=size.small)
        table.cell(tb, 1, 0, "Dernier BOS", text_color=color.white, text_size=size.small)
        table.cell(tb, 2, 0, "Dernier OB VENTE", text_color=cBear, text_size=size.small)
        table.cell(tb, 3, 0, "Dernier OB ACHAT", text_color=cBull, text_size=size.small)
        float cdT = na
        float cdB = na
        int cdS = 0
        int cdSt = 2
        float cuT = na
        float cuB = na
        int cuS = 0
        int cuSt = 2
        for o in obs
            if o.dir == -1
                cdT := o.top
                cdB := o.bot
                cdS := o.stars + (o.ote ? 10 : 0)
                cdSt := o.state
            else
                cuT := o.top
                cuB := o.bot
                cuS := o.stars + (o.ote ? 10 : 0)
                cuSt := o.state
        f_row(1, true, timeframe.period, bosDir, cdT, cdB, cdS, cdSt, cuT, cuB, cuS, cuSt)
        f_row(2, okA, tfA, aBos, aDT, aDB, aDS, aDSt, aUT, aUB, aUS, aUSt)
        f_row(3, okB, tfB, bBos, bDT, bDB, bDS, bDSt, bUT, bUB, bUS, bUSt)
        f_row(4, okC, tfC, cBosD, cDT, cDB, cDS, cDSt, cUT, cUB, cUS, cUSt)
        f_row(5, okD, tfD, dBos, dDT, dDB, dDS, dDSt, dUT, dUB, dUS, dUSt)

// ---- simulation des trades (bougies clôturées)
if barstate.isconfirmed and btOn and trades.size() > 0
    for i = trades.size() - 1 to 0
        Trade t = trades.get(i)
        if bar_index > t.created
            bool done = false
            float exitR = na
            if t.state == 0
                if t.dir == -1 ? high >= t.en : low <= t.en
                    t.state := 1
                    t.fillBar := bar_index
                    t.sess := inSessNow
                    if t.dir == -1 ? high >= t.sl : low <= t.sl
                        done := true
                        exitR := -1.0
                else if bar_index - t.created > btExp
                    bExp += 1
                    trades.remove(i)
                    continue
            else
                if t.dir == -1 ? high >= t.sl : low <= t.sl
                    done := true
                    exitR := -1.0
                else
                    t.mfe := math.max(t.mfe, t.dir == -1 ? (t.en - low) / t.risk : (high - t.en) / t.risk)
                    if t.mfe >= 3.0
                        done := true
                        exitR := 3.0
                    else if bar_index - t.fillBar >= btHold
                        done := true
                        exitR := t.dir * (close - t.en) / t.risk
            if done
                f_rec(t, exitR)
                trades.remove(i)

var table tbBt = table.new(position.bottom_right, 8, 11, bgcolor=color.new(#0B1F3A, 8), border_width=1, border_color=color.new(color.gray, 60))
f_pct(int a, int n) =>
    n > 0 ? str.tostring(100.0 * a / n, "0") + " %" : "-"
f_exp(float r, int n) =>
    n > 0 ? str.tostring(r / n, "0.00") : "-"
f_expCol(float r, int n) =>
    n == 0 ? color.gray : r / n > 0.05 ? color.lime : r / n < 0 ? color.red : color.orange
f_btRow(int r, string name, int k) =>
    int n = bN.get(k)
    color w = color.white
    table.cell(tbBt, 0, r, name, text_color=k == 2 ? c5 : w, text_size=size.small, text_halign=text.align_left)
    table.cell(tbBt, 1, r, str.tostring(n), text_color=n < 30 ? color.orange : w, text_size=size.small)
    table.cell(tbBt, 2, r, f_pct(b1.get(k), n), text_color=w, text_size=size.small)
    table.cell(tbBt, 3, r, f_pct(b2.get(k), n), text_color=w, text_size=size.small)
    table.cell(tbBt, 4, r, f_pct(b3.get(k), n), text_color=w, text_size=size.small)
    table.cell(tbBt, 5, r, f_exp(bR1.get(k), n), text_color=f_expCol(bR1.get(k), n), text_size=size.small)
    table.cell(tbBt, 6, r, f_exp(bR2.get(k), n), text_color=f_expCol(bR2.get(k), n), text_size=size.small)
    table.cell(tbBt, 7, r, f_exp(bR3.get(k), n), text_color=f_expCol(bR3.get(k), n), text_size=size.small)
    0

if barstate.islast and btOn and showBt
    color w = color.white
    table.cell(tbBt, 0, 0, "Entrée " + str.tostring(entPct * 100, "0") + " % OB", text_color=w, text_size=size.small)
    table.cell(tbBt, 1, 0, "Trades", text_color=w, text_size=size.small)
    table.cell(tbBt, 2, 0, "1R atteint", text_color=w, text_size=size.small)
    table.cell(tbBt, 3, 0, "2R atteint", text_color=w, text_size=size.small)
    table.cell(tbBt, 4, 0, "3R atteint", text_color=w, text_size=size.small)
    table.cell(tbBt, 5, 0, "Esp. TP 1R", text_color=w, text_size=size.small)
    table.cell(tbBt, 6, 0, "Esp. TP 2R", text_color=w, text_size=size.small)
    table.cell(tbBt, 7, 0, "Esp. TP 3R", text_color=w, text_size=size.small)
    f_btRow(1, "★★★☆☆", 0)
    f_btRow(2, "★★★★☆", 1)
    f_btRow(3, "★★★★★", 2)
    f_btRow(4, "+ OTE ✓", 3)
    f_btRow(5, "Aligné " + f_tfName(tAl), 4)
    f_btRow(6, "Contre " + f_tfName(tAl), 5)
    f_btRow(7, "En session", 6)
    f_btRow(8, "Hors session", 7)
    f_btRow(9, "TOTAL", 8)
    table.cell(tbBt, 0, 10, "Espérance en R par trade, coût inclus | non déclenchés : " + str.tostring(bExp) + " | en cours : " + str.tostring(trades.size()), text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.merge_cells(tbBt, 0, 10, 7, 10)

// ============================== ALERTES ==============================
bool in5 = false
for o in obs
    if o.stars == 5 and o.state < 2 and high >= o.bot and low <= o.top and not hideTouch
        in5 := true
alertcondition(evBos, "BOS (TF du graphique)", "{{ticker}} : BOS détecté")
alertcondition(evNew5, "Nouvel OB 5★ (TF du graphique)", "{{ticker}} : nouvel order block 5 étoiles")
alertcondition(evNew5Ote, "Nouvel OB 5★ + OTE", "{{ticker}} : nouvel order block 5 étoiles dans l'OTE")
alertcondition(evNew5 and evNewBear, "Nouvel OB VENTE 5★", "{{ticker}} : nouvel OB de vente 5 étoiles")
alertcondition(evNew5 and evNewBull, "Nouvel OB ACHAT 5★", "{{ticker}} : nouvel OB d'achat 5 étoiles")
alertcondition(in5 and not in5[1], "Prix dans un OB 5★", "{{ticker}} : le prix entre dans un OB 5 étoiles")
alertcondition(htfNew5, "Nouvel OB 5★ sur un TF supérieur", "{{ticker}} : nouvel OB 5 étoiles sur un TF supérieur")
