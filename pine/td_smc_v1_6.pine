//@version=6
indicator("TopDown SMC | Execution M15/M5 + DXY v1.6", shorttitle="TD-SMC 1.6", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500, max_bars_back=1000)

// =====================================================================
//  v1.5 — corrections vs v1.4
//  [1] HTF non-repaint : f_struct()[1] + lookahead_on (historique = live)
//  [1] Coût en prix OU en ticks (forex correct)
//  [1] Plus d'écrasement d'ordre : l'ordre en attente = plan du MEILLEUR OB, recalculé chaque bougie
//  [2] Backtest = exactement le setup affiché (même sélection, même score, même plan)
//  [2] OTE / premium-discount évalués à chaque bougie (plus seulement à la création)
//  [3] Liquidité = vrais pools (EQH/EQL, PDH/PDL, range Asie) balayés par l'OB
//  [3] Volume profile inversé : LVN = bonus (HVN = zone d'acceptation)
//  [3] Mitigation à la 1re touche (OB consommé) + filtre premium / discount
//  [3] Displacement : FVG mini 0.3 ATR + bonus proportionnel
//  [4] Filtre sessions London / NY ; TP = liquidité opposée non prise
//  [+] Gestion : 50% TP1 + BE / 50% TP1 sans BE / 100% TP2 ; stats par session + espérance
// =====================================================================

// ============================ INPUTS ================================
gr0 = "0) Affichage (défaut : graphique épuré)"
modeSel   = input.string("Biais H4+H1 aligné seulement", "Directions affichées", options=["Achats + Ventes", "Biais H4+H1 aligné seulement"], group=gr0)
showPlan  = input.bool(true, "Plan entrée / SL / TP du meilleur OB", group=gr0)
showTable = input.bool(true, "Tableau de synthèse", group=gr0)
showAllOb = input.bool(false, "Afficher les autres OB", group=gr0)
showFvg   = input.bool(false, "Afficher FVG / IFVG / BPR", group=gr0)
showLiq   = input.bool(false, "Afficher pools de liquidité", group=gr0)
showCh    = input.bool(false, "Afficher canaux / range", group=gr0)
showIdm   = input.bool(false, "Afficher inducement", group=gr0)
showFibo  = input.bool(false, "Afficher Fibo + zone OTE", group=gr0)
showVP    = input.bool(false, "Afficher volume profile", group=gr0)
showHtf   = input.bool(false, "Afficher BOS / CHoCH HTF", group=gr0)
showH4Ln  = input.bool(false, "Afficher dernier sommet / creux H4", group=gr0)

gr1 = "1) Structure HTF (non-repaint)"
autoTf = input.bool(true, "Réglages AUTO selon le TF du graphique (ignore les valeurs manuelles ci-dessous)", group=gr1)
tfTrendIn  = input.timeframe("240", "TF tendance + BOS", group=gr1)
tfBiasIn   = input.timeframe("60", "TF biais directionnel", group=gr1)
lenTrendIn = input.int(3, "Pivot TF tendance (swing)", minval=1, group=gr1)
lenBiasIn  = input.int(3, "Pivot TF biais (interne)", minval=1, group=gr1)

gr2 = "2) Structure locale (TF du graphique : M15 ou M5)"
lenLTFIn     = input.int(2, "Pivot structure / OB", minval=1, group=gr2)
lenLiqIn     = input.int(3, "Pivot liquidité / dealing range", minval=2, group=gr2)
lenMinorIn   = input.int(5, "Pivot inducement", minval=1, group=gr2)
eqTol      = input.float(0.06, "Tolérance equal H/L (x ATR)", minval=0.01, step=0.01, group=gr2)
rngTol     = input.float(1.4, "Tolérance range (x ATR)", minval=0.1, step=0.1, group=gr2)
minGapIn     = input.float(0.3, "Displacement : FVG mini (x ATR)", minval=0.0, step=0.05, group=gr2)
fvgWin     = input.int(2, "FVG créé par l'OB : fenêtre après l'OB (bougies)", minval=1, maxval=15, group=gr2)
obMax      = input.int(6, "OB gardés en mémoire", minval=1, maxval=30, group=gr2)
fvgMax     = input.int(6, "FVG / IFVG / BPR gardés en mémoire", minval=1, maxval=50, group=gr2)
mitigFirst = input.bool(true, "OB consommé après la 1re touche (mitigation)", group=gr2)
tapWin     = input.int(3, "Fenêtre de la 1re touche (bougies)", minval=1, maxval=20, group=gr2)
drLookIn     = input.int(24, "Dealing range H1 : extension récente (bougies)", minval=5, group=gr2)

gr3 = "3) Fibonacci / OTE"
oteA = input.float(0.618, "OTE borne haute (ratio)", minval=0.3, maxval=0.9, step=0.001, group=gr3)
oteB = input.float(0.79, "OTE borne basse (ratio)", minval=0.4, maxval=0.95, step=0.001, group=gr3)

gr4 = "4) Volume profile"
vpBarsIn  = input.int(200, "Barres analysées", minval=50, maxval=500, group=gr4)
vpRows  = input.int(40, "Lignes (résolution)", minval=10, maxval=80, group=gr4)
vpWidth = input.int(30, "Largeur (barres)", minval=10, maxval=80, group=gr4)
vaPct   = input.float(70.0, "Value area %", minval=50.0, maxval=95.0, group=gr4)

grL = "5) Pools de liquidité"
usePD    = input.bool(true, "PDH / PDL", group=grL)
useAsia  = input.bool(true, "Range Asie (haut / bas)", group=grL)
sessAsia = input.session("0000-0700", "Session Asie", group=grL)

grS = "6) Sessions (killzones)"
useSess = input.bool(true, "Entrées uniquement en session", group=grS)
sessLon = input.session("0800-1100", "London", group=grS)
sessNy  = input.session("1430-1700", "New York", group=grS)
