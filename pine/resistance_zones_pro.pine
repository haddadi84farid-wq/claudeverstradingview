//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// Resistance Zones Pro
// Zones de résistance (offre) détectées par pivots + clustering ATR, scorées
// selon : nb de réactions, volume au pivot, qualité du rejet (mèche), confluence
// HTF et fraîcheur. Les résistances cassées deviennent des "flips" (support).
// Non-repainting : pivots confirmés, HTF via [1] + lookahead_on.
// ─────────────────────────────────────────────────────────────────────────────
indicator("Resistance Zones Pro", "RZ Pro", overlay = true, max_boxes_count = 500, max_labels_count = 500, max_bars_back = 1000)

// ───── Inputs ────────────────────────────────────────────────────────────────
const string G1 = "Détection"
int   pivLen    = input.int(10, "Longueur pivot (barres de chaque côté)", minval = 2, group = G1)
int   atrLen    = input.int(200, "Période ATR", minval = 14, group = G1)
float widthMult = input.float(0.5, "Largeur max d'une zone (× ATR)", minval = 0.1, step = 0.05, group = G1)
float mergeMult = input.float(0.35, "Tolérance de fusion (× ATR)", minval = 0.0, step = 0.05, group = G1)
int   memZones  = input.int(40, "Zones en mémoire", minval = 5, maxval = 200, group = G1)

const string G2 = "Higher Timeframe"
bool   useHTF = input.bool(true, "Intégrer les pivots HTF (confluence)", group = G2)
string htfTf  = input.timeframe("D", "HTF", group = G2)
int    htfLen = input.int(3, "Longueur pivot HTF", minval = 1, group = G2)

const string G3 = "Validation / Invalidation"
string brkMode  = input.string("Clôture", "Cassure validée sur", options = ["Clôture", "Mèche"], group = G3)
float  brkBuf   = input.float(0.10, "Buffer de cassure (× ATR)", minval = 0.0, step = 0.05, group = G3)
bool   keepFlip = input.bool(true, "Conserver les résistances cassées (flip → support)", group = G3)
int    cooldown = input.int(5, "Barres min. entre deux réactions", minval = 1, group = G3)

const string G4 = "Affichage"
int   showN    = input.int(5, "Nb de résistances affichées", minval = 1, maxval = 20, group = G4)
int   showFlip = input.int(2, "Nb de flips affichés", minval = 0, maxval = 10, group = G4)
float minScore = input.float(30, "Score minimum (0-100)", minval = 0, maxval = 100, group = G4)
int   extendR  = input.int(30, "Extension à droite (barres)", minval = 0, group = G4)
bool  showLbl  = input.bool(true, "Étiquettes", group = G4)
bool  showTbl  = input.bool(true, "Tableau de synthèse", group = G4)
color cRes     = input.color(#E53935, "Résistance", group = G4)
color cHTF     = input.color(#8E24AA, "Résistance HTF", group = G4)
color cFlip    = input.color(#43A047, "Flip (ex-résistance)", group = G4)

// ───── Types & état ──────────────────────────────────────────────────────────
type Zone
    float top
    float bot
    int   originT
    int   touches
    float volRel
    float rej
    bool  htf
    bool  flipped
    int   lastTouch

var array<Zone> zones = array.new<Zone>()

float atr    = ta.atr(atrLen)
float volSma = ta.sma(nz(volume), 50)
float buf    = nz(atr) * brkBuf

// Score 0-100 : réactions 40 / volume 20 / rejet 20 / HTF 20, décroissance avec l'âge
zScore(Zone z) =>
    float t     = math.min(z.touches, 5) / 5.0 * 40.0
    float v     = math.min(z.volRel, 3.0) / 3.0 * 20.0
    float r     = math.min(math.max(z.rej, 0.0), 1.0) * 20.0
    float h     = z.htf ? 20.0 : 0.0
    float decay = math.max(0.5, 1.0 - (bar_index - z.lastTouch) / 2000.0)
    (t + v + r + h) * decay

// Ajoute un pivot ou le fusionne dans un cluster existant (centroïde pondéré)
addZone(float top, float bot, int originT, int touchBar, float volRel, float rej, bool isHtf) =>
    float tol  = atr * mergeMult
    float capW = atr * widthMult * (isHtf ? 2.0 : 1.5)
    bool merged = false
    for z in zones
        if not z.flipped and top >= z.bot - tol and bot <= z.top + tol
            float w = z.touches
            z.top := (z.top * w + top) / (w + 1)
            z.bot := (z.bot * w + bot) / (w + 1)
            if z.top - z.bot > capW
                z.bot := z.top - capW
            if touchBar - z.lastTouch >= cooldown
                z.touches += 1
            z.lastTouch := math.max(z.lastTouch, touchBar)
            z.volRel    := math.max(z.volRel, volRel)
            z.rej       := (z.rej * w + rej) / (w + 1)
            z.htf       := z.htf or isHtf
            z.originT   := math.min(z.originT, originT)
            merged      := true
            break
    if not merged
        zones.push(Zone.new(top, bot, originT, 1, volRel, rej, isHtf, false, touchBar))
        if zones.size() > memZones
            // éviction de la zone la plus faible (pas la plus ancienne)
            int   worst  = 0
            float worstS = 1e10
            for [i, zz] in zones
                float s = zScore(zz)
                if s < worstS
                    worstS := s
                    worst  := i
            zones.remove(worst)
    merged

// ───── Pivots chart TF ───────────────────────────────────────────────────────
float ph = ta.pivothigh(high, pivLen, pivLen)
if not na(ph) and not na(atr)
    float bodyTop = math.max(open[pivLen], close[pivLen])
    float maxW    = atr * widthMult
    float minW    = atr * 0.15
    float pBot    = math.min(math.max(bodyTop, ph - maxW), ph - minW)
    float rng     = high[pivLen] - low[pivLen]
    float rej     = rng > 0 ? (ph - bodyTop) / rng : 0.0
    float vr      = volSma[pivLen] > 0 ? nz(volume[pivLen]) / volSma[pivLen] : 1.0
    addZone(ph, pBot, time[pivLen], bar_index - pivLen, vr, rej, false)

// ───── Pivots HTF (non-repainting) ───────────────────────────────────────────
htfPivot(int len) =>
    float p  = ta.pivothigh(high, len, len)
    float vs = ta.sma(nz(volume), 20)
    [p[1], math.max(open[len + 1], close[len + 1]), high[len + 1] - low[len + 1], nz(volume[len + 1]), vs[len + 1], time[len + 1]]

[hP, hB, hR, hV, hVs, hT] = request.security(syminfo.tickerid, htfTf, htfPivot(htfLen), lookahead = barmerge.lookahead_on)
bool htfOk  = useHTF and timeframe.in_seconds(htfTf) > timeframe.in_seconds(timeframe.period)
bool htfNew = ta.change(time(htfTf)) != 0
if htfOk and htfNew and not na(hP) and not na(atr)
    float maxW = atr * widthMult * 2.0
    float minW = atr * 0.25
    float hBot = math.min(math.max(hB, hP - maxW), hP - minW)
    float hRej = hR > 0 ? (hP - hB) / hR : 0.0
    float hVr  = hVs > 0 ? hV / hVs : 1.0
    // n'ajoute que si la zone HTF n'est pas déjà cassée sur le TF courant
    if close < hP
        addZone(hP, hBot, hT, bar_index, hVr, hRej, true)

// ───── Mise à jour : réactions, cassures, flips ──────────────────────────────
bool  evEnter   = false
bool  evReject  = false
bool  evBreak   = false
float nearBot   = na
float nearTop   = na
float nearScore = na

if zones.size() > 0
    for i = zones.size() - 1 to 0
        Zone  z = zones.get(i)
        float s = zScore(z)
        if not z.flipped
            float brkPx = brkMode == "Clôture" ? close : high
            if brkPx > z.top + buf
                evBreak := evBreak or s >= minScore
                if keepFlip
                    z.flipped := true
                else
                    zones.remove(i)
                continue
            if high >= z.bot and high[1] < z.bot and s >= minScore
                evEnter := true
            if high >= z.bot and close < z.bot and bar_index - z.lastTouch >= cooldown
                z.touches   += 1
                z.lastTouch := bar_index
                evReject    := evReject or s >= minScore
            if s >= minScore and (na(nearBot) or z.bot < nearBot)
                nearBot   := z.bot
                nearTop   := z.top
                nearScore := s
        else if close < z.bot - buf
            zones.remove(i)  // flip invalidé : support perdu

// Valeurs exposées (Data Window / lecture MCP data_get_study_values)
plot(nearTop,   "Résistance proche — haut",  color = cRes, display = display.data_window)
plot(nearBot,   "Résistance proche — bas",   color = cRes, display = display.data_window)
plot(nearScore, "Résistance proche — score", display = display.data_window)
plot(atr > 0 and not na(nearBot) ? math.max(0, nearBot - close) / atr : na, "Distance (ATR)", display = display.data_window)

// ───── Rendu (dernier bar uniquement) ────────────────────────────────────────
var array<box>   bxs = array.new<box>()
var array<label> lbs = array.new<label>()
var table        tbl = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 80), border_width = 1)
int tfMs = timeframe.in_seconds() * 1000

drawZone(Zone z, float s) =>
    color c      = z.flipped ? cFlip : z.htf ? cHTF : cRes
    int   tr     = int(math.round(85 - s * 0.55))
    int   rightT = time + extendR * tfMs
    bxs.push(box.new(z.originT, z.top, rightT, z.bot, xloc = xloc.bar_time, border_color = color.new(c, 30), border_style = z.flipped ? line.style_dashed : line.style_solid, bgcolor = color.new(c, tr)))
    if showLbl
        string kind = z.flipped ? "FLIP → S" : z.htf ? "R HTF" : "R"
        float  dAtr = atr > 0 ? (z.flipped ? close - z.top : z.bot - close) / atr : 0.0
        string txt  = kind + "  " + str.tostring(math.round(s)) + "/100 · " + str.tostring(z.touches) + " réactions · " + str.tostring(dAtr, "#.##") + " ATR"
        lbs.push(label.new(rightT, (z.top + z.bot) / 2, txt, xloc = xloc.bar_time, style = label.style_label_left, color = color.new(c, 100), textcolor = c, size = size.small))

if barstate.islast
    for b in bxs
        b.delete()
    for l in lbs
        l.delete()
    bxs.clear()
    lbs.clear()

    array<float> dR = array.new<float>()
    array<int>   iR = array.new<int>()
    array<float> dF = array.new<float>()
    array<int>   iF = array.new<int>()
    for [i, z] in zones
        float s = zScore(z)
        if s >= minScore
            if not z.flipped and z.top + buf >= close
                dR.push(math.max(0, z.bot - close))
                iR.push(i)
            else if z.flipped
                dF.push(math.max(0, close - z.top))
                iF.push(i)

    if dR.size() > 0
        array<int> oR = dR.sort_indices(order.ascending)
        for k = 0 to math.min(showN, oR.size()) - 1
            Zone z = zones.get(iR.get(oR.get(k)))
            drawZone(z, zScore(z))
    if dF.size() > 0 and showFlip > 0
        array<int> oF = dF.sort_indices(order.ascending)
        for k = 0 to math.min(showFlip, oF.size()) - 1
            Zone z = zones.get(iF.get(oF.get(k)))
            drawZone(z, zScore(z))

    if showTbl
        table.cell(tbl, 0, 0, "RZ Pro", text_color = color.white, text_size = size.small)
        table.cell(tbl, 1, 0, str.tostring(dR.size()) + " zones actives", text_color = color.white, text_size = size.small)
        table.cell(tbl, 0, 1, "Résistance proche", text_color = color.white, text_size = size.small)
        table.cell(tbl, 1, 1, na(nearBot) ? "—" : str.tostring(nearBot, format.mintick) + " – " + str.tostring(nearTop, format.mintick), text_color = cRes, text_size = size.small)
        table.cell(tbl, 0, 2, "Score", text_color = color.white, text_size = size.small)
        table.cell(tbl, 1, 2, na(nearScore) ? "—" : str.tostring(math.round(nearScore)) + "/100", text_color = color.white, text_size = size.small)
        table.cell(tbl, 0, 3, "Distance", text_color = color.white, text_size = size.small)
        table.cell(tbl, 1, 3, na(nearBot) or atr <= 0 ? "—" : str.tostring(math.max(0, nearBot - close) / atr, "#.##") + " ATR", text_color = color.white, text_size = size.small)

// ───── Alertes ───────────────────────────────────────────────────────────────
alertcondition(evEnter,  "RZ — Entrée en zone de résistance", "{{ticker}} entre dans une zone de résistance ({{close}})")
alertcondition(evReject, "RZ — Rejet sur résistance",         "{{ticker}} rejette une zone de résistance ({{close}})")
alertcondition(evBreak,  "RZ — Cassure de résistance",        "{{ticker}} casse une résistance ({{close}})")
